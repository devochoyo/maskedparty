# ============================================================
# MaskedParty — Environment Variables
# Location : config/secure/.env
# WARNING  : NEVER commit this file to version control.
#            Add config/secure/ to your .gitignore.
# ============================================================

# ── Application ──────────────────────────────────────────────
BASE_URL=https://maskedparty.name.ng

# ── Database ─────────────────────────────────────────────────
DB_HOST=CHANGE_ME
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME

# ── Flutterwave ───────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=CHANGE_ME
FLUTTERWAVE_SECRET_HASH=CHANGE_ME

# ── VideoSDK ─────────────────────────────────────────────────
VIDEOSDK_API_KEY=CHANGE_ME
VIDEOSDK_SECRET_KEY=CHANGE_ME

# ── SMTP / Mail ──────────────────────────────────────────────
SMTP_HOST=CHANGE_ME
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=CHANGE_ME
SMTP_FROM_NAME=CHANGE_ME
